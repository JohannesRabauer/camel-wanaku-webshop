# Copy to .env and fill in. Docker Compose reads .env automatically.

# Needed by the moderation agent (default provider).
OPENAI_API_KEY=

# Only if you run the agents with AGENT_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# Where the moderator gets its tools. Default: straight to the shop (unprotected).
# Through Wanaku, once it is set up:
# MODERATOR_MCP_URL=http://wanaku:8081/moderation/mcp
