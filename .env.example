# Copy to .env and fill in. Docker Compose reads .env automatically.

# Needed by the moderation agent (default provider).
OPENAI_API_KEY=

# Only if you run the agents with AGENT_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# Which Wanaku rules apply: wanaku-open.yaml (everything allowed) or wanaku-policy.yaml (default deny).
# WANAKU_CONFIG=wanaku-policy.yaml

# Where the moderator gets its tools: through Wanaku (default) or straight to the shop (unprotected).
# MODERATOR_MCP_URL=http://shop:9090/mcp
