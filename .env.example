# Copy to .env and fill in. Docker Compose reads .env automatically.

# Needed by the agent (default provider) and by the LLM evaluator in wanaku-governed.yaml.
OPENAI_API_KEY=

# Only if you run the agent with AGENT_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# Which Wanaku rules apply: wanaku-open.yaml, wanaku-policy.yaml (no API key needed) or wanaku-governed.yaml.
# WANAKU_CONFIG=wanaku-governed.yaml
